{
  "name": "tympan",
  "version": "0.5.0",
  "description": "Deterministic, secure, fast HTML→PDF converter: one semantic section per page, runtime print-CSS defeated, self-verifying output. Zero config.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Blvckpanda/Tympan.git"
  },
  "homepage": "https://github.com/Blvckpanda/Tympan#readme",
  "bugs": {
    "url": "https://github.com/Blvckpanda/Tympan/issues"
  },
  "bin": {
    "tympan": "bin/tympan.js",
    "tympan-ui": "bin/tympan-ui.js"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin/",
    "src/",
    "types/",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "smoke": "node scripts/smoke.mjs",
    "smoke:real": "node scripts/smoke-real.mjs",
    "ui": "node bin/tympan-ui.js"
  },
  "keywords": [
    "html",
    "pdf",
    "converter",
    "deterministic",
    "ai",
    "generated",
    "chromium",
    "playwright",
    "sections",
    "deck",
    "proposal"
  ],
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "3.11.174",
    "playwright": "1.63.0"
  }
}
